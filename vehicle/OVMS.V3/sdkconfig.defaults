# --- ESP32-S3 / LILYGO T-2CAN (WROOM-1U N16R8) ---
CONFIG_IDF_TARGET="esp32s3"

# Flash 16MB QIO 80MHz, PSRAM 8MB OPI
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# OVMS partition table (custom, 16MB)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console via USB-Serial/JTAG -> UART0 (GPIO43/44) stays free for the A7670E modem
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# OVMS legacy code paths rely on pre-FreeRTOS-V8 type names
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

# ovms_module.cpp task/heap monitoring
CONFIG_HEAP_TASK_TRACKING=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Suppress GCC12+ -Wformat warnings that fire on the new toolchain (uint32_t == unsigned long)
CONFIG_COMPILER_DISABLE_GCC12_WARNINGS=y

# OVMS cellular stack uses lwIP PPPoS for the modem's data connection
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y

# Keep SoftAP driver buffers within the ESP32-S3 internal heap budget.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
# CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER is not set

# --- OVMS board configuration ---
CONFIG_OVMS=y
CONFIG_OVMS_HW_REMAP_GPIO=y
CONFIG_OVMS_HW_DEFAULT_GPIO_MAP=n
CONFIG_OVMS_GPIO_MAP_FILE="t2can_can.h"

# Enable Bluetooth for compile of esp32bluetooth (S3 = BLE/GATT only)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
# OVMS uses only legacy GAP advertising APIs (esp_ble_gap_start_advertising,
# esp_ble_gap_config_adv_data), which compile only with BLE 4.2 features;
# 4.2 and 5.0 are mutually exclusive per Kconfig
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n

# Components that are not present on the T-2CAN board
CONFIG_OVMS_COMP_MAX7317=n
CONFIG_OVMS_COMP_EXT12V=n
CONFIG_OVMS_COMP_ADC=n
CONFIG_OVMS_COMP_SDCARD=n
CONFIG_OVMS_COMP_EXTERNAL_SWCAN=n

# CAN backends: can1 = on-chip TWAI (GPIO6/7), can2 = MCP2515; esp32can incompatible with ESP32-S3
CONFIG_OVMS_COMP_TWAICAN=y
CONFIG_OVMS_COMP_MCP2515=y
